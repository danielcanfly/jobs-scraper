# ─────────────────────────────────────────────────────────────
# 環境變數設定 (複製這檔成 .env 然後填值)
# ─────────────────────────────────────────────────────────────
# 所有 Sheet 工具 (audit_sheet / get_stats / sync_jobs_to_sheet) 都 fail-closed:
# 沒設 SHEET_ID / SHEET_GID / GSPREAD_SA_KEY_PATH 就會回結構化錯誤,
# 不會 fallback 到任何作者的 Sheet。crawl_jobs (純爬) 不需要這三個。

# 1. Google Sheets service account JSON 位置
#    必填 (設了 Sheet tools 才不會報 CREDENTIAL_FILE_MISSING)
#    預設 .secrets/gsheet-sa.json — 建議把你的 SA key 放這
GSPREAD_SA_KEY_PATH=.secrets/gsheet-sa.json

# 2. 自己的 Google Sheet ID (從 Sheet URL 抓: docs.google.com/spreadsheets/d/{這個}/edit)
#    必填 (留空 → audit_sheet / get_stats / sync_jobs_to_sheet 會回 CONFIG_MISSING)
SHEET_ID=your_google_sheet_id_here

# 3. 自己 Sheet 裡要寫入的 tab GID
#    必填 (留空 → 同上 fail-closed)
#    從 Sheet URL 抓 gid: docs.google.com/spreadsheets/d/.../edit?gid={這個}
SHEET_GID=0

# 4. (可選) 自訂 JobStreet 搜尋關鍵字
#    預設 5 個: product manager / product director / director of product / head of product / product lead
#    例: JOBSTREET_KEYWORDS="product manager,head of product"
JOBSTREET_KEYWORDS=

# 5. (可選) LinkedIn 其他國家 geoId
#    預設 102454443 (Singapore)
#    Taiwan: 104187078
#    Shanghai: 107388191
LINKEDIN_GEO_ID=102454443
