# ─────────────────────────────────────────────────────────────
# jobs-scraper v1.1.0 environment (copy to .env and fill your own values)
# ─────────────────────────────────────────────────────────────
# crawl_jobs does not need Google configuration.
# Sheet tools fail closed and never fall back to the package author's Sheet.

# 1. Google Sheets service-account JSON path
#    Keep the JSON outside Git. Share your target spreadsheet with this SA identity.
GSPREAD_SA_KEY_PATH=.secrets/gsheet-sa.json

# 2. Your Google Spreadsheet ID
#    From: https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
#    Required by initialize_job_tracker / sync_jobs_to_sheet / audit_sheet / get_stats.
SHEET_ID=

# 3. Legacy v1.0 only (optional)
#    v1.1.0 server_v1_1.py resolves <REGION>-Raw by worksheet name and does NOT
#    require users to configure a GID. Keep empty unless intentionally running server.py.
SHEET_GID=

# 4. Optional JobStreet search keywords
#    Example: JOBSTREET_KEYWORDS="product manager,head of product"
JOBSTREET_KEYWORDS=

# 5. Optional legacy/default LinkedIn geoId override for direct CLI usage.
#    v1.1 MCP region routing passes validated presets itself.
#    Singapore: 102454443 | Taiwan: 104187078 | Shanghai: 107388191
LINKEDIN_GEO_ID=102454443
